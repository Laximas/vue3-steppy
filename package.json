{
  "name": "vue3-steppy",
  "description": "A customizable Vue 3 Stepper plugin",
  "version": "1.8.0",
  "type": "module",
  "private": false,
  "author": "Mike Konstantakos",
  "homepage": "https://laximas.github.io/vue3-steppy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laximas/vue3-steppy.git"
  },
  "bugs": {
    "url": "https://github.com/Laximas/vue3-steppy/issues"
  },
  "keywords": [
    "vue3",
    "vue",
    "stepper",
    "steppy",
    "vue-stepper",
    "vue-steppy",
    "vue3-stepper",
    "vue3-steppy"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/vue3-steppy.cjs",
  "module": "./dist/vue3-steppy.es.js",
  "types": "./dist/vue3-steppy.d.ts",
  "typings": "./dist/vue3-steppy.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vue3-steppy.d.ts",
      "import": "./dist/vue3-steppy.es.js",
      "require": "./dist/vue3-steppy.cjs",
      "default": "./dist/vue3-steppy.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && shx cp ./src/vue3-steppy.d.ts dist",
    "build:demo": "vite build -c vite.demo.config.js",
    "prepublishOnly": "pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "lint": "eslint . --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vitest": "^5.1.0",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  },
  "directories": {
    "lib": "lib"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.28.1",
      "minimatch": "^11.0.1",
      "glob": "^14.0.2"
    }
  },
  "packageManager": "pnpm@10.34.7"
}
